# Detection-as-code: Suricata rules
# Every rule must carry MITRE ATT&CK metadata and have at least one positive test case in tests/cases.yaml.
# SID range 9000000-9000999 is reserved for this repository.

alert http $HOME_NET any -> 169.254.169.254 any (msg:"DAC CLOUD Instance metadata IAM credential path requested"; flow:established,to_server; http.uri; content:"/latest/meta-data/iam/security-credentials"; startswith; classtype:attempted-recon; metadata:mitre_technique_id T1552.005, mitre_tactic_id TA0006; sid:9000001; rev:1;)

alert dns $HOME_NET any -> any any (msg:"DAC DNS Possible tunneling - unusually long query name"; dns.query; bsize:>60; classtype:policy-violation; metadata:mitre_technique_id T1071.004, mitre_tactic_id TA0011; sid:9000002; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"DAC POLICY Stratum mining protocol subscribe"; flow:established,to_server; content:"\"method\""; content:"mining.subscribe"; distance:0; within:40; classtype:policy-violation; metadata:mitre_technique_id T1496, mitre_tactic_id TA0040; sid:9000003; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"DAC WEB Webshell command execution attempt"; flow:established,to_server; http.uri; content:".php"; content:"cmd="; distance:0; pcre:"/cmd=(whoami|id|uname|hostname)(&|$)/i"; classtype:web-application-attack; metadata:mitre_technique_id T1505.003, mitre_tactic_id TA0003; sid:9000004; rev:1;)
